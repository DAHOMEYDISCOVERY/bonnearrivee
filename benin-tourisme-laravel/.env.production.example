#################################################################
# ENVIRONNEMENT PRODUCTION — bonnearrivee.bj
# Copier ce fichier en .env sur le serveur OVH et remplir les
# valeurs marquees <A_REMPLIR>. Ne JAMAIS versionner le .env rempli.
#################################################################

APP_NAME="Bonne Arrivée"
APP_ENV=production
APP_KEY=<A_REMPLIR_VIA_php_artisan_key:generate>
APP_DEBUG=false
APP_URL=https://bonnearrivee.bj
APP_LOCALE=fr_FR
APP_FALLBACK_LOCALE=fr_FR
APP_FAKER_LOCALE=fr_FR
APP_MAINTENANCE_DRIVER=file

# ----- Base de donnees MySQL OVH -----
DB_CONNECTION=mysql
DB_HOST=<A_REMPLIR_HOST_MYSQL_OVH>
DB_PORT=3306
DB_DATABASE=<A_REMPLIR_NOM_BASE>
DB_USERNAME=<A_REMPLIR_USER>
DB_PASSWORD=<A_REMPLIR_PASSWORD>

# ----- Sessions / Cache / Queue -----
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=file
QUEUE_CONNECTION=database

# ----- Stockage fichiers -----
FILESYSTEM_DISK=local

# ----- Mail (SMTP OVH ou autre) -----
# Exemple avec SMTP OVH classique (changer selon ton fournisseur mail)
MAIL_MAILER=smtp
MAIL_HOST=ssl0.ovh.net
MAIL_PORT=465
MAIL_USERNAME=<A_REMPLIR_EMAIL_ENVOI>
MAIL_PASSWORD=<A_REMPLIR_MOT_DE_PASSE>
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=reservations@dahomeydiscovery.com
MAIL_FROM_NAME="${APP_NAME}"

# ----- KKiaPay (paiements catalogue restaurants) -----
# Clefs disponibles sur https://app.kkiapay.me/parametres/api
KKIAPAY_SANDBOX=false
KKIAPAY_PUBLIC_KEY=<A_REMPLIR>
KKIAPAY_PRIVATE_KEY=<A_REMPLIR>
KKIAPAY_SECRET=<A_REMPLIR>
KKIAPAY_CATALOG_AMOUNT=15000

# ----- Logs -----
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ----- Nextcloud (PDF catalogue Wadunu + archives) -----
# Dossier Nextcloud partage prive accessible via WebDAV
NEXTCLOUD_BASE_URL=https://nextcloud.dahomeyinfo.fr
NEXTCLOUD_WEBDAV_PATH=/remote.php/dav/files/<A_REMPLIR_USER>
NEXTCLOUD_USERNAME=<A_REMPLIR_USER>
NEXTCLOUD_PASSWORD=<A_REMPLIR_MOT_DE_PASSE_APP>
# URL publique de partage du PDF catalogue (option simple sans WebDAV)
WADUNU_PDF_SHARE_URL=
